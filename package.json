{
  "name": "valenor",
  "private": true,
  "version": "0.1.0",
  "description": "VALENOR — digital fashion house. Monorepo root. See docs/architecture.md.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @valenor/web dev",
    "build": "pnpm --filter @valenor/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "npm run generate --workspace=@valenor/db",
    "db:migrate": "npm run migrate:dev --workspace=@valenor/db",
    "db:seed": "npm run seed --workspace=@valenor/db",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "framer-motion": "^12.42.2"
  }
}