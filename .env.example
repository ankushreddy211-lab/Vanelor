# Copy to .env.local for local dev. Every var here is validated at process
# boot by apps/web/lib/env.ts — the app fails loudly on a missing/malformed
# var rather than failing confusingly at runtime (architecture doc §21).

NODE_ENV=development

# Postgres connection string. Matches docker-compose.yml's default credentials.
DATABASE_URL="postgresql://valenor:valenor@localhost:5432/valenor?schema=public"

# Redis — reservation locks, rate limiting, cache (architecture §11.1, §20).
REDIS_URL="redis://localhost:6379"

# Session secret, passed directly to Better Auth's `secret` option
# (lib/auth/auth.ts) — not read via its own BETTER_AUTH_SECRET env var name,
# so there's one env schema, not two. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-32-byte-secret"

# Public app URL, used for absolute links in emails/webhooks.
APP_URL="http://localhost:3000"

# Shared secret checked against the Authorization header on
# /api/cron/drops-sync — whatever triggers that endpoint (Vercel Cron, a
# system cron curling it, etc.) must send `Authorization: Bearer <value>`.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-real-secret"

# Optional. Get a free access key at unsplash.com/developers. Powers
# server-side atmosphere/texture photography (fabric, tailoring tools,
# material studies — never "model wearing the piece" shots, since no
# photoshoot exists yet) on chapter sections. Leave unset in dev/CI —
# those surfaces fall back to the generative motif system cleanly.
UNSPLASH_ACCESS_KEY=""

# Optional. Hostname of the CDN/bucket that will serve real VALENOR
# product photography once a shoot exists (e.g. "assets.valenor.com" or
# a Cloudinary/S3 domain). Must be set — and added to next.config.mjs's
# image remotePatterns — before piece.images[].url can point there.
PRODUCT_IMAGE_CDN_HOST=""
